<!--
  A BUI component that shows a Pygfx scene: the scene is rendered offscreen
  by Pygfx and each frame is shown in a BUI image node.

    <PygfxViewport :scene="SceneComponent" v-bind="scene_props" />

  The scene component is rendered by its own collagraph instance with the
  PygfxRenderer, and gets the props of the viewport as its props. Drag in
  the viewport to orbit the camera, and use the mouse wheel to zoom.

  Events:
    frame(dt): emitted on every tick (~60 per second) while `animate` is set
    rendered(width, height, ms): emitted after each rendered frame
-->
<viewport fill />

<script>
import time

import numpy as np
import pygfx as gfx
from blenderui.components import Image
from blenderui.components.core import EV_MOTION, EV_PRESS, EV_RELEASE, EV_WHEEL
from observ import scheduler
from rendercanvas.offscreen import RenderCanvas

import collagraph as cg
from collagraph.renderers.bui_renderer import Window

TICK_MS = 16


class Viewport(Image):
    """BUI image node that shows rendered frames and reports pointer drags."""

    def __init__(self):
        super().__init__(fit="fill")
        # Receive raw pointer events (press, motion, release, wheel)
        self.set("events", True)
        self.on_drag = None
        self.on_zoom = None
        self._pointer = None

    def _on_event(self, kind, ref, a, b):
        if kind == EV_PRESS:
            self._pointer = (a, b)
        elif kind == EV_RELEASE:
            self._pointer = None
        elif kind == EV_MOTION and self._pointer is not None:
            (x, y), self._pointer = self._pointer, (a, b)
            if self.on_drag:
                self.on_drag(a - x, b - y)
        elif kind == EV_WHEEL and self.on_zoom:
            self.on_zoom(a)


cg.BuiRenderer.register_element("viewport", Viewport)


class PygfxViewport(cg.Component):
    def mounted(self):
        self.window = self.find_window()
        self.size = (0, 0)
        self.draw_pending = False
        self.last_tick = time.perf_counter()

        self.canvas = RenderCanvas(size=(1, 1), pixel_ratio=1)
        self.wgpu_renderer = gfx.renderers.WgpuRenderer(self.canvas)
        self.canvas.request_draw(self._render_scene)
        self.camera = gfx.PerspectiveCamera(45)
        self.controller = gfx.OrbitController(self.camera)
        self.container = gfx.Scene()

        # Render the scene component with its own collagraph instance. All
        # instances share observ's scheduler, so keep the flush handler of
        # the BUI renderer: updates then stay on BUI's event loop.
        request_flush = scheduler.request_flush
        self.gui = cg.Collagraph(
            renderer=cg.PygfxRenderer(), event_loop_type=cg.EventLoopType.SYNC
        )
        scheduler.register_request_flush(request_flush)
        self.gui.renderer.add_on_change_handler(self.request_draw)
        self.gui.render(self.props["scene"], self.container, state=self.props)
        self.camera.show_object(self.container, view_dir=(-1, -0.6, -1), scale=1.3)

        self.element.on_drag = self.orbit
        self.element.on_zoom = self.zoom
        if host := self.host():
            host.after(TICK_MS, self.tick)

    def before_unmount(self):
        self.window = None
        self.gui.fragment.unmount()

    def host(self):
        """The (open) host window to schedule timers on, if any."""
        host = self.window.host if self.window is not None else None
        return host if host is not None and host.is_open else None

    def find_window(self):
        node = self.element
        while node is not None and not isinstance(node, Window):
            node = node.parent
        return node if node is not None and node.host is not None else None

    def tick(self):
        if not (host := self.host()):
            return
        now = time.perf_counter()
        dt, self.last_tick = now - self.last_tick, now
        if self.props.get("animate"):
            self.emit("frame", dt)
        # Render again when BUI changed the size of the viewport
        if self.viewport_size() != self.size:
            self.request_draw()
        host.after(TICK_MS, self.tick)

    def viewport_size(self):
        _, _, w, h = self.element.rect
        return (w, h)

    def request_draw(self):
        # Coalesce all changes of a single update into one frame
        if not self.draw_pending and (host := self.host()):
            self.draw_pending = True
            host.after(0, self.draw)

    def draw(self):
        self.draw_pending = False
        w, h = self.viewport_size()
        if w < 1 or h < 1:
            return
        start = time.perf_counter()
        if (w, h) != self.size:
            self.size = (w, h)
            self.canvas.set_logical_size(w, h)
        frame = np.asarray(self.canvas.draw())
        self.element.set_image(w, h, frame.tobytes())
        ms = (time.perf_counter() - start) * 1000
        self.emit("rendered", w, h, ms)

    def _render_scene(self):
        self.wgpu_renderer.render(self.container, self.camera)

    def rect(self):
        return (0, 0, *self.size)

    def orbit(self, dx, dy):
        self.controller.rotate((-dx * 0.01, -dy * 0.01), self.rect())
        self.request_draw()

    def zoom(self, delta):
        self.controller.zoom((0, delta * 0.1), self.rect())
        self.request_draw()
</script>
